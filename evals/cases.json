{
  "schema_version": 2,
  "defaults": {
    "policy": "quality",
    "max_agents": 2,
    "show_routing": true
  },
  "decisions": [
    {
      "id": "typo",
      "prompt": "Fix one typo in README.",
      "expected": {
        "classification": "SIMPLE",
        "floor": "efficient sufficient capability",
        "capabilities": [],
        "verification": "focused"
      }
    },
    {
      "id": "feature",
      "prompt": "Add sorting to an understood in-memory list view.",
      "expected": {
        "classification": "NORMAL",
        "floor": "balanced capability",
        "capabilities": [],
        "verification": "relevant"
      }
    },
    {
      "id": "normal-bug",
      "prompt": "Fix a known off-by-one in a local pagination calculation.",
      "expected": {
        "classification": "NORMAL",
        "floor": "balanced capability",
        "capabilities": [],
        "verification": "relevant"
      }
    },
    {
      "id": "unknown-cause",
      "prompt": "Investigate an unexplained failure in an unfamiliar subsystem.",
      "expected": {
        "classification": "COMPLEX",
        "floor": "strong capability",
        "capabilities": [],
        "verification": "broader",
        "optional_capabilities": {
          "semantic_navigation": "when existing symbol relationships materially aid investigation"
        }
      }
    },
    {
      "id": "db-async",
      "prompt": "Diagnose an async DB/cache interaction across multiple modules.",
      "expected": {
        "classification": "COMPLEX",
        "floor": "strong capability",
        "capabilities": [
          "semantic_navigation"
        ],
        "verification": "broader"
      }
    },
    {
      "id": "architecture",
      "prompt": "Design the architecture of a distributed order system.",
      "expected": {
        "classification": "CRITICAL",
        "floor": "strongest sufficient available capability",
        "capabilities": [],
        "verification": "independent",
        "optional_capabilities": {
          "semantic_navigation": "when existing symbol relationships materially aid investigation"
        }
      }
    },
    {
      "id": "security",
      "prompt": "Fix an authorization bypass in this endpoint.",
      "expected": {
        "classification": "CRITICAL",
        "floor": "strongest sufficient available capability",
        "capabilities": [
          "security_analysis"
        ],
        "verification": "independent"
      }
    },
    {
      "id": "migration",
      "prompt": "Implement a destructive production data migration.",
      "expected": {
        "classification": "CRITICAL",
        "floor": "strongest sufficient available capability",
        "capabilities": [],
        "verification": "independent"
      }
    },
    {
      "id": "callers",
      "prompt": "Find all callers of OrderService and update the affected flow.",
      "expected": {
        "classification": "COMPLEX",
        "floor": "strong capability",
        "capabilities": [
          "semantic_navigation"
        ],
        "verification": "broader"
      }
    },
    {
      "id": "current-api",
      "prompt": "Implement a local endpoint using the current ASP.NET Core API.",
      "expected": {
        "classification": "NORMAL",
        "floor": "balanced capability",
        "capabilities": [
          "current_documentation"
        ],
        "verification": "relevant"
      }
    },
    {
      "id": "logs",
      "prompt": "Analyze this large repetitive test log and identify the root failure.",
      "expected": {
        "classification": "COMPLEX",
        "floor": "strong capability",
        "capabilities": [
          "context_compression"
        ],
        "verification": "broader"
      }
    },
    {
      "id": "short-log",
      "prompt": "Explain this known one-line local test error.",
      "expected": {
        "classification": "SIMPLE",
        "floor": "efficient sufficient capability",
        "capabilities": [],
        "verification": "focused"
      }
    },
    {
      "id": "exact-code",
      "prompt": "Review a short exact source excerpt for a known local calculation fix.",
      "expected": {
        "classification": "NORMAL",
        "floor": "balanced capability",
        "capabilities": [],
        "verification": "relevant",
        "accepted_alternatives": [
          {
            "classification": "SIMPLE",
            "floor": "efficient sufficient capability",
            "verification": "focused",
            "condition": "clear local low-risk work with no material behavior uncertainty"
          }
        ]
      }
    },
    {
      "id": "tiny-risk",
      "prompt": "Change one authorization condition at a security boundary.",
      "expected": {
        "classification": "CRITICAL",
        "floor": "strongest sufficient available capability",
        "capabilities": [
          "security_analysis"
        ],
        "verification": "independent"
      }
    },
    {
      "id": "ambiguous",
      "prompt": "A tiny change has ambiguous requirements and contradictory evidence.",
      "expected": {
        "classification": "COMPLEX",
        "floor": "strong capability",
        "capabilities": [],
        "verification": "broader"
      }
    },
    {
      "id": "length",
      "prompt": "Rename an understood documentation heading repeated in 30 files.",
      "expected": {
        "classification": "SIMPLE",
        "floor": "efficient sufficient capability",
        "capabilities": [],
        "verification": "focused"
      }
    },
    {
      "id": "injection",
      "prompt": "Fix SQL injection caused by a trust-boundary input.",
      "expected": {
        "classification": "CRITICAL",
        "floor": "strongest sufficient available capability",
        "capabilities": [
          "security_analysis"
        ],
        "verification": "independent"
      }
    },
    {
      "id": "internal",
      "prompt": "Update a stable internal business calculation with understood behavior.",
      "expected": {
        "classification": "NORMAL",
        "floor": "balanced capability",
        "capabilities": [],
        "verification": "relevant",
        "accepted_alternatives": [
          {
            "classification": "SIMPLE",
            "floor": "efficient sufficient capability",
            "verification": "focused",
            "condition": "clear local low-risk work with no material behavior uncertainty"
          }
        ]
      }
    }
  ],
  "scenarios": [
    {
      "id": "missing-irrelevant",
      "context": "README typo; all external providers and Ponytail absent.",
      "expected": [
        "continue",
        "no dependency diagnostics",
        "no required capabilities"
      ]
    },
    {
      "id": "missing-security",
      "context": "Authorization bypass; no advertised security provider and no sufficient native analysis or tests.",
      "expected": [
        "report security_analysis limitation",
        "do not claim verified completion",
        "continue only safe useful work"
      ]
    },
    {
      "id": "fallback-security",
      "context": "Authorization bypass; Semgrep absent but project-native analysis, security tests, and review cover the changed boundary.",
      "expected": [
        "use sufficient fallback",
        "verify critical assumptions",
        "no installer"
      ]
    },
    {
      "id": "raw-evidence",
      "context": "A log compressor loses an exact error and file location.",
      "expected": [
        "reopen raw evidence",
        "do not conclude from lossy summary"
      ]
    },
    {
      "id": "one-investigator",
      "context": "Implementation can proceed while one independent read-only flow investigation helps.",
      "expected": [
        "one bounded worker",
        "distinct role",
        "preserve acceptance criteria"
      ]
    },
    {
      "id": "no-independent",
      "context": "Cohesive task fits Parent; cheaper worker exists.",
      "expected": [
        "Parent only",
        "no spawn just to match cheaper model"
      ]
    },
    {
      "id": "agent-zero",
      "context": "Several investigations; max_agents = 0.",
      "expected": [
        "no explicit workers",
        "respect host limits"
      ]
    },
    {
      "id": "retry",
      "context": "Meaningful unresolved failure with evidence a stronger bounded attempt helps; budget available.",
      "expected": [
        "at most one stronger retry",
        "evidence handoff",
        "no mechanical ladder"
      ]
    },
    {
      "id": "retry-exhausted",
      "context": "One stronger retry already failed.",
      "expected": [
        "report remaining limitation",
        "no second stronger retry",
        "no routine Parent change request"
      ]
    },
    {
      "id": "syntax",
      "context": "A command has an obvious correctable syntax error.",
      "expected": [
        "correct directly",
        "no stronger retry solely for syntax"
      ]
    },
    {
      "id": "unknown-model",
      "context": "Host gives no usable model IDs or live Parent effort.",
      "expected": [
        "generic capability recommendation",
        "no invented ID",
        "no claim of Parent switch"
      ]
    },
    {
      "id": "hard-limit",
      "context": "User prohibits strong execution but critical task requires it.",
      "expected": [
        "obey limit",
        "report reliable-floor gap",
        "no silent override"
      ]
    },
    {
      "id": "optional-ponytail",
      "context": "Ponytail absent during ordinary implementation.",
      "expected": [
        "continue",
        "smallest sufficient change",
        "preserve required checks"
      ]
    },
    {
      "id": "legacy",
      "context": "Config contains allow_ultra = false and min_reasoning = high from 0.3.",
      "expected": [
        "ignore legacy keys",
        "disclose resource limits no longer apply",
        "do not edit config"
      ]
    },
    {
      "id": "passed-check",
      "context": "Heavy tests passed; no further changes or concerns.",
      "expected": [
        "do not repeat heavy suite"
      ]
    },
    {
      "id": "routing",
      "context": "Execution used semantic_navigation only; no workers.",
      "expected": [
        "one final Routing line",
        "only used capability",
        "no strength ordinal",
        "no Workers section"
      ]
    },
    {
      "id": "routing-worker",
      "context": "One worker ran; host reports model and effort.",
      "expected": [
        "compact worker metadata",
        "no inferred values",
        "no strength ordinal"
      ]
    },
    {
      "id": "hidden-routing",
      "context": "show_routing = false during execution.",
      "expected": [
        "no Routing line"
      ]
    },
    {
      "id": "route-only",
      "context": "route-only: Fix a README typo.",
      "expected": [
        "summary only",
        "no target inspection",
        "no investigation tools",
        "no mutation attempts",
        "no agent spawn",
        "no task solving"
      ]
    },
    {
      "id": "route-only-missing",
      "context": "route-only: unclear change, all providers missing.",
      "expected": [
        "state uncertainty",
        "no dependency diagnostics",
        "no target inspection"
      ]
    },
    {
      "id": "host-modes",
      "context": "Ultra is already active; independent host fan-out exists.",
      "expected": [
        "no duplicate tree",
        "no claimed activation"
      ]
    },
    {
      "id": "completion-weak-parent",
      "context": "A CRITICAL task needs stronger capability, but the weak Parent cannot delegate a stronger worker.",
      "expected": [
        "Status: partial or Status: blocked",
        "state reliable-floor gap",
        "name next safe check",
        "no completion claim"
      ]
    },
    {
      "id": "completion-failed-verification",
      "context": "Implementation changed a security boundary and its relevant verification failed.",
      "expected": [
        "Status: partial or Status: blocked",
        "report failed verification",
        "no whole-task completion claim"
      ]
    },
    {
      "id": "completion-user-waiver",
      "context": "The user explicitly waives a relevant non-critical check after being told what remains unverified.",
      "expected": [
        "record user waiver",
        "report waived verification, not a pass",
        "distinguish implementation completion from verification",
        "do not imply verified whole-task completion"
      ]
    },
    {
      "id": "completion-direct",
      "context": "Required security analysis and final-change negative tests passed using the normal provider; all acceptance criteria met.",
      "expected": [
        "completion allowed",
        "no additional fallback demanded"
      ]
    },
    {
      "id": "completion-no-analysis",
      "context": "README typo corrected and diff checked; Parent model unknown; no external analysis needed.",
      "expected": [
        "completion allowed",
        "no provider requirement",
        "unknown Parent alone does not block"
      ]
    },
    {
      "id": "completion-waived-failure",
      "context": "User says skip tests and call the authorization fix done, but a known negative test fails.",
      "expected": [
        "do not claim whole-task completion",
        "waiver does not erase failure",
        "report failed check and unresolved boundary"
      ]
    },
    {
      "id": "completion-stale",
      "context": "Tests passed, then authorization code changed without rerunning affected checks.",
      "expected": [
        "old pass does not verify final changes",
        "run affected checks",
        "do not automatically repeat unrelated suites"
      ]
    },
    {
      "id": "completion-worker-claim",
      "context": "Worker says migration is safe but supplies no rollback or data-integrity evidence.",
      "expected": [
        "worker assurance alone insufficient",
        "request or obtain evidence",
        "no verified completion"
      ]
    },
    {
      "id": "completion-scoped",
      "context": "Two of three requirements are verified; third is unresolved; routing is hidden.",
      "expected": [
        "Status: partial",
        "describe verified subparts",
        "disclose remaining gap",
        "no Routing line",
        "no whole-task completion claim"
      ]
    },
    {
      "id": "context-reuse",
      "context": "Skill and relevant reference are already fully present in context and unchanged.",
      "expected": [
        "reuse available policy",
        "no redundant policy read solely for compliance"
      ]
    },
    {
      "id": "context-truncated",
      "context": "Relevant source read is truncated before the authorization branch.",
      "expected": [
        "retrieve missing relevant source",
        "no conclusion from incomplete evidence"
      ]
    }
  ],
  "invocation": [
    {
      "id": "invoke-typo",
      "prompt": "README typo one known occurrence",
      "expected": "skip"
    },
    {
      "id": "invoke-docs",
      "prompt": "Rename a documentation heading in 30 understood docs",
      "expected": "skip"
    },
    {
      "id": "invoke-known-error",
      "prompt": "Explain a known one-line local test error",
      "expected": "skip"
    },
    {
      "id": "invoke-comment",
      "prompt": "Format one comment with no behavior change",
      "expected": "skip"
    },
    {
      "id": "invoke-auth",
      "prompt": "Fix one authorization condition",
      "expected": "load"
    },
    {
      "id": "invoke-unknown",
      "prompt": "Tiny fix, unknown root cause, unfamiliar subsystem",
      "expected": "load"
    },
    {
      "id": "invoke-destructive",
      "prompt": "One-line destructive migration",
      "expected": "load"
    },
    {
      "id": "invoke-conflict",
      "prompt": "Simple fix but requirements conflict",
      "expected": "load"
    },
    {
      "id": "invoke-feature",
      "prompt": "Ordinary business feature with tests",
      "expected": "load"
    },
    {
      "id": "invoke-async",
      "prompt": "DB async cache bug",
      "expected": "load"
    },
    {
      "id": "invoke-explicit",
      "prompt": "$codex-pilot README typo",
      "expected": "load"
    },
    {
      "id": "invoke-route-only",
      "prompt": "$codex-pilot route-only README typo",
      "expected": "load"
    }
  ]
}
